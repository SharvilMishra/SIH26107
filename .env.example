# Supabase project settings -> API (Project Settings -> API in the dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
# Optional: direct Postgres connection string (Project Settings -> Database),
# only needed if you run raw SQL/migrations outside the Supabase client.
SUPABASE_DB_URL=

# --- Groq (LLM synthesis for chat answers) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hybrid retrieval tuning (Phase 2)
HYBRID_DENSE_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
RERANK_TOP_K=15
RERANK_FINAL_K=4

# Deterministic verification (Phase 3) -- leave blank to skip live lookups
# and fall back to format-only validation
BIS_CARE_BASE_URL=

# Multilingual (Phase 5)
BHASHINI_API_KEY=
DEFAULT_LANGUAGE=en

# Firebase Authentication (email/password + Google sign-in)
# Base64-encode your service account JSON before setting this:
#   Linux/Mac:  base64 -i serviceAccountKey.json | tr -d '\n'
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_JSON=